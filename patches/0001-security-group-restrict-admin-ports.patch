diff --git a/configure_enclave.sh b/configure_enclave.sh
index e05de65..d057050 100644
--- a/configure_enclave.sh
+++ b/configure_enclave.sh
@@ -599,6 +599,17 @@ fi
 ############################
 SECURITY_GROUP_NAME="instance-script-sg"
 
+# Restrict admin ports (SSH, dev port 3000) to the operator's current public IP
+# instead of 0.0.0.0/0. 443 (the enclave's public attested endpoint) stays open
+# to the world since that's the whole point of exposing it.
+MY_IP=$(curl -s --max-time 5 https://checkip.amazonaws.com || true)
+if [[ "$MY_IP" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]]; then
+  ADMIN_CIDR="${MY_IP}/32"
+else
+  echo "WARNING: could not resolve current public IP; falling back to 0.0.0.0/0 for SSH/3000. Tighten this manually after launch." >&2
+  ADMIN_CIDR="0.0.0.0/0"
+fi
+
 SECURITY_GROUP_ID=$(aws ec2 describe-security-groups \
   --region "$REGION" \
   --group-names "$SECURITY_GROUP_NAME" \
@@ -610,7 +621,7 @@ if [ "$SECURITY_GROUP_ID" = "None" ] || [ -z "$SECURITY_GROUP_ID" ]; then
   SECURITY_GROUP_ID=$(aws ec2 create-security-group \
     --region "$REGION" \
     --group-name "$SECURITY_GROUP_NAME" \
-    --description "Security group allowing SSH (22), HTTPS (443), and port 3000" \
+    --description "SSH+3000 restricted to operator IP, HTTPS (443) public" \
     --query "GroupId" --output text)
 
   # Ensure that the security group is created successfully
@@ -619,14 +630,15 @@ if [ "$SECURITY_GROUP_ID" = "None" ] || [ -z "$SECURITY_GROUP_ID" ]; then
     exit 1
   fi
 
+  echo "Restricting SSH (22) and dev port 3000 to $ADMIN_CIDR"
   aws ec2 authorize-security-group-ingress --region "$REGION" \
-    --group-id "$SECURITY_GROUP_ID" --protocol tcp --port 22 --cidr 0.0.0.0/0
+    --group-id "$SECURITY_GROUP_ID" --protocol tcp --port 22 --cidr "$ADMIN_CIDR"
 
   aws ec2 authorize-security-group-ingress --region "$REGION" \
     --group-id "$SECURITY_GROUP_ID" --protocol tcp --port 443 --cidr 0.0.0.0/0
 
   aws ec2 authorize-security-group-ingress --region "$REGION" \
-    --group-id "$SECURITY_GROUP_ID" --protocol tcp --port 3000 --cidr 0.0.0.0/0
+    --group-id "$SECURITY_GROUP_ID" --protocol tcp --port 3000 --cidr "$ADMIN_CIDR"
 else
   echo "Using existing security group $SECURITY_GROUP_NAME ($SECURITY_GROUP_ID)"
 fi
